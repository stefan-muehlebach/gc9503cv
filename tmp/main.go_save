package main

import (
	//"flag"
	"log"
	"time"
	"periph.io/x/conn/v3/gpio"
	"periph.io/x/conn/v3/gpio/gpioreg"
	"periph.io/x/host/v3"
)

//-----------------------------------------------------------------------------

type Panel struct {
	SDA, SCL, CS, RST gpio.PinIO
}

func (p *Panel) Configure() {
	if p.SDA = gpioreg.ByName(SDAPinName); p.SDA == nil {
		log.Fatal("SDA: gpio pin not found")
	}
	if p.SCL = gpioreg.ByName(SCLPinName); p.SDA == nil {
		log.Fatal("SCL: gpio pin not found")
	}
	if p.CS = gpioreg.ByName(CSPinName); p.SDA == nil {
		log.Fatal("CS: gpio pin not found")
	}
	if p.RST = gpioreg.ByName(RSTPinName); p.RST == nil {
		log.Fatal("RST: gpio pin not found")
	}
	p.SDA.Out(gpio.Low)
	p.SCL.Out(gpio.Low)
	p.CS.Out(gpio.High)
	p.RST.Out(gpio.High)
}

func (p *Panel) Send(b byte) {
	for range 8 {
		p.SCL.Out(gpio.Low)
		if b & 0x80 != 0x00 {
			p.SDA.Out(gpio.High)
		} else {
			p.SDA.Out(gpio.Low)
		}
		p.SCL.Out(gpio.High)
		b <<= 1
	}
}

func (p *Panel) CmdWrite(b byte) {
	p.CS.Out(gpio.Low)
	p.SDA.Out(gpio.Low)
	p.SCL.Out(gpio.Low)
	p.SCL.Out(gpio.High)
	p.Send(b)
	p.CS.Out(gpio.High)
}

func (p *Panel) DataWrite(b byte) {
	p.CS.Out(gpio.Low)
	p.SDA.Out(gpio.High)
	p.SCL.Out(gpio.Low)
	p.SCL.Out(gpio.High)
	p.Send(b)
	p.CS.Out(gpio.High)
}

func (p *Panel) Init() {
	p.Reset(true)
	for _, obj := range InitCmds {
		p.CmdWrite(obj.cmd)
		for _, dat := range obj.data {
			p.DataWrite(dat)
		}
		if obj.delay > 0 {
			time.Sleep(time.Duration(obj.delay) * time.Millisecond)
		}
	}
}

func (p *Panel) Reset(hw bool) {
	if hw {
		p.RST.Out(gpio.Low)
		time.Sleep(120 * time.Millisecond)
		p.RST.Out(gpio.High)
		time.Sleep(120 * time.Millisecond)
	} else {
		p.CmdWrite(0x01)
		time.Sleep(120 * time.Millisecond)
	}
}

//-----------------------------------------------------------------------------

type CmdSequence struct {
	cmd byte
	data []byte
	delay int
}

const (
	SLEEPIN  = 0x10
	SLEEPOUT = 0x11
	PARTON   = 0x12
	PARTOFF  = 0x13
	DISPOFF  = 0x28
	DISPON   = 0x29
	IDLEON   = 0x38
	IDLEOFF  = 0x39
	PIXFMT   = 0x3A
	EXTCMDEN = 0xF0
	RGBIFCTL = 0xB0
	DISPCTL  = 0xB1
)

var (
	InitCmds = []CmdSequence{
		// EXTC command set enable
		{0xF0, []byte{0x55, 0xAA, 0x52, 0x08, 0x00}, 0},
		{0xF6, []byte{0x5A, 0x87}, 0},
		{0xC1, []byte{0x3F}, 0},
		{0xCD, []byte{0x25}, 0},
		{0xC9, []byte{0x10}, 0},
		{0xF8, []byte{0x8A}, 0},
		{0xAC, []byte{0x45}, 0},
		{0xA7, []byte{0x47}, 0},
		{0xA0, []byte{0xCC}, 0},

		// CHP_CTL1
		{0x86, []byte{0x99, 0xA3, 0xA3, 0x31}, 0},

		{0xFA, []byte{0x08, 0x08, 0x00, 0x04}, 0},
		{0xA3, []byte{0x6E}, 0},
		{0xFD, []byte{0x28, 0x3C, 0x00}, 0},

		// VREG_CTL2
		{0x9A, []byte{0x4a}, 0},
		// VREG_CTL5
		{0x9B, []byte{0x22}, 0},
		// VREG_CTL1
		{0x82, []byte{0x00, 0x00}, 0},
		// VREG_CTL0
		{0x80, []byte{0x54}, 0},
		// RGB Interface Signals Control
		{0xB0, []byte{0x00, 0x0E, 0x0E, 0x14, 0x04}, 0},

		// DISPLAY_CTL
		{0xB1, []byte{0x33}, 0},

		// Interface Pixel Format
		// 0x60 - Use 18Bit RGB interface; corresponds to DPI[2:0]
		{0x3A, []byte{0x60}, 0},

		{0x7A, []byte{0x0F, 0x13}, 0},
		{0x7B, []byte{0x0F, 0x13}, 0},
		{0x6D, []byte{0x0c, 0x03, 0x1e, 0x02, 0x08, 0x1a, 0x19, 0x03, 0x0d, 0x0e, 0x0f, 0x10, 0x1E, 0x1E, 0x1E, 0x1E, 0x1E, 0x1E, 0x1E, 0x1E, 0x11, 0x12, 0x13, 0x14, 0x03, 0x19, 0x1a, 0x07, 0x01, 0x1E, 0x03, 0x0c}, 0},
		{0x64, []byte{0x38, 0x04, 0x03, 0xc4, 0x03, 0x03, 0x38, 0x02, 0x03, 0xc6, 0x03, 0x03, 0x2C, 0x7A, 0x2C, 0x7A}, 0},
