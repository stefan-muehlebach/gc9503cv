//-----------------------------------------------------------------------------

const (
	SDAPinName = "GPIO26"
	SCLPinName = "GPIO27"
	CSPinName  = "GPIO19"
	RSTPinName = "GPIO10"
)

func main() {
	if _, err := host.Init(); err != nil {
		log.Fatalf("host.Init(): %v", err)
	}

	panel := Panel{}
	panel.Configure()
	panel.Init()
}

