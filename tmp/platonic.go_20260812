		Vector{c5, -b5, -c5},
		Vector{c5, -c5, -c5},

		Vector{-c5, -c5, -b5},
		Vector{-c5,  c5, -b5},
		Vector{-c5, c5, -c5},
		Vector{-c5, b5, -c5},
