	// Schweizerkreuz-Box (wird noch nicht korrekt gezeichnet, da
	f5 = 1.0/32.0
	a5 = f5 * 16.0
	b5 = f5 * 10.0
	c5 = f5 *  3.0

	SwissPoints = []Vector{
