//-----------------------------------------------------------------------------

const (
	cursorDir = "cursors"
)

type Cursor struct {
    img image.Image
    hotspot geom.Point
}

func OpenCursor(fileName string, hotspot geom.Point) *Cursor {
    c := &Cursor{}
    fh, err := cursorFiles.Open(path.Join(cursorDir, fileName))
    if err != nil {
        log.Fatalf("Couldn't open image file: %v", err)
    }
    defer fh.Close()
    c.img, _, err = image.Decode(fh)
    if err != nil {
        log.Fatalf("Couldn't decode image data: %v", err)
    }
    c.hotspot = hotspot
    return c
}   

var (
	LeftPointer  = OpenCursor("left_ptr.png", geom.Point{4, 4})
	RightPointer = OpenCursor("right_ptr.png", geom.Point{27, 4})
	Cross        = OpenCursor("cross.png", geom.Point{15, 15})
	Crosshair    = OpenCursor("crosshair.png", geom.Point{15, 15})
	Ibeam        = OpenCursor("ibeam.png", geom.Point{13, 24})
)

