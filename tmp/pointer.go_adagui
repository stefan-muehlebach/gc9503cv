package adagui

import (
	"embed"
	"image"
	"log"
	"path"
	"github.com/stefan-muehlebach/adatft"
	"github.com/stefan-muehlebach/gg"
	//"github.com/stefan-muehlebach/gg/colors"
	"github.com/stefan-muehlebach/gg/geom"
)

//go:embed cursors/*
var cursorFiles embed.FS

// Dieser Typ steht fuer das SPI Interface zum STMPE - dem Touchscreen.
type Pointer struct {
	adatft.Pointer
	Cursor *Cursor
}

// Funktionen
func OpenPointer() *Pointer {
	p := &Pointer{}
	p.Pointer = *adatft.OpenPointer()
	p.Cursor = OpenCursor("left_ptr.png", geom.Point{4, 4})
	return p
}

func (p *Pointer) Draw(gc *gg.Context) {
    pt := p.Pos.Sub(p.Cursor.hotspot)
    gc.DrawImage(p.Cursor.img, pt.X, pt.Y)
	log.Printf("Pointer.Draw()")
	log.Printf("  p.Pos    : %v", p.Pos)
	log.Printf("  pt       : %v", pt)
}

